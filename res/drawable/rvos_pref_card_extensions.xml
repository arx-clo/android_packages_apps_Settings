<?xml version="1.0" encoding="utf-8"?>
<ripple
    android:color="@color/rvos_pref_ripple"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:id="@android:id/mask">
        <shape>
            <solid
                android:color="#ffffffff" />
            <corners
                android:topLeftRadius="@dimen/rvos_pref_card_radius"
                android:topRightRadius="@dimen/rvos_pref_card_radius"
                android:bottomLeftRadius="@dimen/rvos_pref_card_radius"
                android:bottomRightRadius="@dimen/rvos_pref_card_radius" />
        </shape>
    </item>
    <item
        android:id="@android:id/background">
        <shape
            android:shape="rectangle">
            <corners
                android:topLeftRadius="@dimen/rvos_pref_card_radius"
                android:topRightRadius="@dimen/rvos_pref_card_radius"
                android:bottomLeftRadius="@dimen/rvos_pref_card_radius"
                android:bottomRightRadius="@dimen/rvos_pref_card_radius" />
            <gradient
                android:startColor="@android:color/system_accent1_200"
                android:endColor="@android:color/system_accent1_200"
                android:angle="360.0"
                android:type="linear"
                android:centerColor="@android:color/system_accent2_200" />
        </shape>
    </item>
</ripple>