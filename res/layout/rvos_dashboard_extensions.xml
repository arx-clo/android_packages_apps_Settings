<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:id="@id/container"
    android:background="@drawable/rvos_pref_card_extensions"
    android:clipToPadding="false"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/rvos_pref_card_vertical_padding"
    android:layout_marginBottom="4.0dip"
    android:layout_marginHorizontal="@dimen/rvos_pref_card_horizontal_padding"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:paddingTop="16.0dip"
        android:paddingBottom="16.0dip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="1.0"
        android:layout_marginStart="16.0dip">
        <TextView
            android:textColor="@color/m3_sys_color_dynamic_light_on_tertiary_container"
            android:ellipsize="marquee"
            android:id="@android:id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            style="@style/rvos_text_primary_medium" />
        <TextView
            android:gravity="end|center"
            android:layout_gravity="end|center"
            android:id="@android:id/summary"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="@color/m3_sys_color_dynamic_light_on_tertiary_container"
            android:alpha="0.8"
            style="@style/rvos_text_secondary" />
    </RelativeLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="fill_parent"
        android:minWidth="64.0dip">
        <androidx.cardview.widget.CardView
            android:layout_width="28.0dip"
            android:layout_height="28.0dip"
            app:cardBackgroundColor="#85ffffff"
            app:cardCornerRadius="99.0dip"
            app:cardElevation="0.0dip">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="24.0dip"
                android:layout_height="24.0dip"
                android:src="@drawable/drawable_7f08041b"
                android:tint="@color/m3_sys_color_dynamic_light_on_tertiary_container" />
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</LinearLayout>